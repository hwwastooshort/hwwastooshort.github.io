---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/harvey.jpg';
import { site } from '../data/site';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Base title={t('about.title')}>
  <header class="page-header">
    <h1>{t('about.title')}</h1>
  </header>

  <Picture
    class="photo"
    src={photo}
    alt={site.name}
    width={480}
    height={600}
    fit="cover"
    position="bottom"
    widths={[240, 480]}
    sizes="240px"
    formats={['avif', 'webp']}
    loading="eager"
  />

  <div class="prose">
    {
      lang === 'de' ? (
        <>
          <p>Hallo,</p>
          <p>
            ich bin Harvey, oft hw geschrieben, und bin Masterstudent und Software Engineer. Ich interessiere mich für
            Softwareentwicklung, KI, Magic: The Gathering und meine Vögel. Momentan entwickle ich eine Seite zum
            Managen von Pathfinder-1e-Kampagnen.
          </p>
          <p>Mein Fokus im Studium liegt auf Software Engineering, KI und Automatisierung.</p>
          <p>
            Mehr Infos findet ihr im <a href={localizePath('/', lang)}>Lebenslauf</a>.
          </p>
        </>
      ) : (
        <>
          <p>Hi,</p>
          <p>
            I'm Harvey, often written as hw, a master's student and software engineer. I'm interested in software
            development, AI, Magic: The Gathering and my birds. Right now I'm building a site for managing Pathfinder
            1e campaigns.
          </p>
          <p>My focus at university is on software engineering, AI and automation.</p>
          <p>
            You'll find more in my <a href={localizePath('/', lang)}>CV</a>.
          </p>
        </>
      )
    }
  </div>
</Base>

<style>
  .photo {
    width: 15rem;
    max-width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: 2.5rem;
    border-radius: 4px;
  }
</style>

---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { site } from '../data/site';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/ui';
import { getPosts, getProjects } from '../lib/content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const posts = (await getPosts(lang)).slice(0, 3);
---

<Base>
  <section class="intro">
    <h1>{site.name}</h1>
    <p class="role muted">{site.role[lang]}</p>
    <p class="text">{site.intro[lang]}</p>
  </section>

  {
    featured.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('home.projects')}</h2>
        <ProjectList projects={featured} lang={lang} />
        <p class="more small">
          <a href={localizePath('/projects', lang)}>{t('home.allProjects')} →</a>
        </p>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="section">
        <h2 class="section-title">{t('home.posts')}</h2>
        <PostList posts={posts} lang={lang} />
        <p class="more small">
          <a href={localizePath('/blog', lang)}>{t('home.allPosts')} →</a>
        </p>
      </section>
    )
  }
</Base>

<style>
  .role {
    margin-top: 0.25rem;
  }

  .text {
    margin-top: 1.5rem;
    max-width: 36rem;
  }

  .more {
    margin-top: 1rem;
  }

  .more a {
    color: var(--muted);
    text-decoration: none;
  }

  .more a:hover {
    color: var(--text);
  }
</style>
